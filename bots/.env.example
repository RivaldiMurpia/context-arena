# Monad testnet
RPC_URL=https://testnet-rpc.monad.xyz
# Deployed ContextArena address (fill after forge script deploy)
ARENA_ADDRESS=0x0000000000000000000000000000000000000000
# Deployer key (TESTNET ONLY, never mainnet, never commit this file)
DEPLOYER_KEY=0x...
# Private keys (TESTNET ONLY, never mainnet, never commit this file)
GAME_MASTER_KEY=0x...
AGENT_KEYS=0x...,0x...,0x...
# LLM providers for agent brains (OpenAI-compatible chat/completions).
# Primary: Qwen 3.8 Max via Alibaba Cloud Model Studio (QwenCloud) — key at home.qwencloud.com/api-keys
# Standard PAYG keys start with sk- ; Token Plan keys (sk-sp-) are auto-routed.
QWEN_API_KEY=...
# (DASHSCOPE_API_KEY is accepted as an alias)
# Fallback: Nebius Token Factory — key at nebius.com
NEBIUS_API_KEY=...
# Fallback 2: Atria ASI — 100M free tokens, key at api.atria-asi.ai/console/keys
ATRIA_API_KEY=...
# Fallback 3: NVIDIA NIM — free tier at build.nvidia.com
NVIDIA_API_KEY=...
# Optional overrides:
# QWEN_MODEL=qwen3.8-max
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MAX_TOKENS=4000  # reasoning trace burns tokens; keep generous
# NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# ATRIA_MODEL=Atria-Dawn-Preview
# NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NEBIUS_THINKING=1  # re-enable Lightning's thinking trace (default: disabled for clean JSON)
# LLM_DEBUG=true     # log raw LLM output when JSON parsing fails
# Demo mode: short rounds for rehearsal/video
DEMO_MODE=false
